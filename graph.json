{
  "version": 1,
  "description": "A to-do API maintained by a graph of agents. Nodes are units of work, edges carry pass/fail, loops carry failures back to a fixer. Agents are the markdown files in agents/.",
  "start": "plan",
  "nodes": {
    "plan": {
      "agent": "planner",
      "next": "build"
    },
    "build": {
      "agent": "coder",
      "next": "verify"
    },
    "verify": {
      "agent": "runner",
      "pass": "review",
      "fail": "fix"
    },
    "fix": {
      "agent": "coder",
      "next": "verify",
      "max_loops": 3
    },
    "review": {
      "agent": "reviewer",
      "pass": "ship",
      "fail": "fix"
    },
    "ship": {
      "agent": "runner",
      "next": "learn"
    },
    "learn": {
      "agent": "scribe",
      "next": null
    }
  }
}
